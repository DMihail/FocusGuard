# --- OS ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Secrets & local env ---
.env
.env.*
!.env.example
keystore.properties
**/keystore.properties
!**/keystore.properties.example
android/keystore.properties
!android/keystore.properties.example
android/app/google-services.json
!android/app/google-services.ci.json
**/GoogleService-Info.plist
!ios/FocusGuard/GoogleService-Info.ci.plist

# --- Node / JS ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.jsbundle
.eslintcache
*.tsbuildinfo

# Metro / RN tooling
.metro-health-check*
.icon-gen/

# Yarn Berry (keep shared release/plugin config when present)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity

# --- Testing ---
coverage/
junit.xml
test-results/
# --- IDE (never commit machine-local IDE state) ---
.idea/
**/.idea/
!.idea/runConfigurations/
# Optional: share run configs — uncomment if your team commits them:
# !.idea/runConfigurations/*.xml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.iml
*.ipr
*.iws

# --- Cursor / local AI tooling ---
.cursor/*
!.cursor/rules/
!.cursor/skills/

# --- Android ---
.gradle/
**/.gradle/
local.properties
**/local.properties
.cxx/
**/.cxx/
.externalNativeBuild/
.kotlin/
captures/
*.hprof

# Generated by Gradle `updateDaemonJvm` (machine-specific JDK toolchain URLs)
android/gradle/gradle-daemon-jvm.properties

# Signing — debug keystore is committed for reproducible local builds
*.keystore
!android/app/debug.keystore
*.jks
android/keystores/*
!android/keystores/.gitkeep

# Build outputs
build/
**/build/
android/app/release/
*.apk
*.aab

