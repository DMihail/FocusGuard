{
  "name": "FocusGuard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test -- --ci --watchman=false",
    "start": "react-native start",
    "test": "jest",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:android": "npm run e2e:build:android && npm run e2e:test:android",
    "e2e:build:android:attached": "detox build --configuration android.att.debug",
    "e2e:test:android:attached": "detox test --configuration android.att.debug",
    "e2e:build:android:release": "detox build --configuration android.emu.release",
    "e2e:test:android:release": "detox test --configuration android.emu.release",
    "e2e:build:android:e2eRelease": "detox build --configuration android.emu.e2eRelease",
    "e2e:test:android:e2eRelease": "detox test --configuration android.emu.e2eRelease",
    "e2e:android:e2eRelease": "npm run e2e:build:android:e2eRelease && npm run e2e:test:android:e2eRelease",
    "e2e:build:android:e2eRelease:attached": "detox build --configuration android.att.e2eRelease",
    "e2e:test:android:e2eRelease:attached": "detox test --configuration android.att.e2eRelease",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:ios": "npm run e2e:build:ios && npm run e2e:test:ios",
    "e2e:sync-testids": "node scripts/sync-e2e-testids.js",
    "prepare": "husky"
  },
  "codegenConfig": {
    "name": "NativeUsageStatsSpec",
    "type": "modules",
    "jsSrcsDir": "./source/specs",
    "android": {
      "javaPackageName": "com.nativeusagestats"
    }
  },
  "dependencies": {
    "@react-navigation/elements": "^2.9.20",
    "@react-navigation/native": "^7.2.6",
    "@react-navigation/native-stack": "^7.17.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^3.0.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.9.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "detox": "^20.51.3",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "{source,__tests__}/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "index.js": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "{.eslintrc,.prettierrc,babel.config,jest.config}.js": [
      "prettier --write"
    ]
  }
}
