{
  "name": "FocusGuard",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "check": "eslint . --max-warnings 0 && prettier --check . && tsc --noEmit && jest --watchman=false --ci",
    "test": "jest",
    "android:release:check": "test -f android/keystore.properties && npm run check",
    "start": "react-native start",
    "prepare": "husky"
  },
  "codegenConfig": {
    "name": "KeeptTurboModuleSpec",
    "type": "modules",
    "jsSrcsDir": "./source/specs",
    "android": {
      "javaPackageName": "com.keept.turbomodule"
    },
    "ios": {
      "modulesProvider": {
        "KeeptTurboModule": "RCTKeeptTurboModule"
      }
    }
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/crashlytics": "^26.3.2",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.7.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.12.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "{source,__tests__}/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache --cache-location .eslintcache --max-warnings 0",
      "prettier --write"
    ],
    "index.js": [
      "eslint --fix --cache --cache-location .eslintcache --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "{.eslintrc,.prettierrc,babel.config,jest.config}.js": [
      "prettier --write"
    ]
  }
}
